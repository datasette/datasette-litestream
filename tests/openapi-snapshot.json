    "/-/litestream/api/status": {
      "get": {
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "description": "Payload of GET /-/litestream/api/status.\n\nOnly ``running`` is always present. When the plugin never started a\ndaemon the endpoint returns ``{\"running\": false}`` and nothing else;\nwhen the daemon was started but has died (crash, failed rotation\nrestart), ``running`` is false and the rest of the payload \u2014 warnings,\navailable databases \u2014 is still populated so the UI can show context.",
                  "properties": {
                    "running": {
                      "title": "Running",
                      "type": "boolean"
                    },
                    "can_manage": {
                      "anyOf": [
                        {
                          "type": "boolean"
                        },
                        {
                          "type": "null"
                        }
                      ],
                      "default": null,
                      "title": "Can Manage"
                    },
                    "metrics_enabled": {
                      "anyOf": [
                        {
                          "type": "boolean"
                        },
                        {
                          "type": "null"
                        }
                      ],
                      "default": null,
                      "title": "Metrics Enabled"
                    },
                    "daemon": {
                      "anyOf": [
                        {
                          "$ref": "#/components/schemas/DaemonInfo"
                        },
                        {
                          "type": "null"
                        }
                      ],
                      "default": null
                    },
                    "socket_error": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "null"
                        }
                      ],
                      "default": null,
                      "title": "Socket Error"
                    },
                    "databases": {
                      "anyOf": [
                        {
                          "items": {
                            "$ref": "#/components/schemas/ManagedDatabase"
                          },
                          "type": "array"
                        },
                        {
                          "type": "null"
                        }
                      ],
                      "default": null,
                      "title": "Databases"
                    },
                    "available": {
                      "anyOf": [
                        {
                          "items": {
                            "$ref": "#/components/schemas/AvailableDatabase"
                          },
                          "type": "array"
                        },
                        {
                          "type": "null"
                        }
                      ],
                      "default": null,
                      "title": "Available"
                    },
                    "warnings": {
                      "anyOf": [
                        {
                          "items": {
                            "type": "string"
                          },
                          "type": "array"
                        },
                        {
                          "type": "null"
                        }
                      ],
                      "default": null,
                      "title": "Warnings"
                    }
                  },
                  "required": [
                    "running"
                  ],
                  "title": "Status",
                  "type": "object"
                }
              }
            }
          }
        },
        "parameters": []
      }
